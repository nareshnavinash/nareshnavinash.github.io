{
  "name": "naresh-3d-portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-profile": "cp profile.html static/profile.html && (cmp -s resume.json static/data/resume.json || cp resume.json static/data/resume.json) && cp css/theme.css static/css/theme.css && cp css/styles.css static/css/styles.css && cp js/main.js static/js/main.js && cp js/three-scene.js static/js/three-scene.js && cp public/assets/profile.jpg static/profile.jpg",
    "predev": "npm run sync-profile",
    "dev": "vite --mode development",
    "prebuild": "npm run sync-profile",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "compress": "node scripts/compress.js static/",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.3",
    "@gltf-transform/cli": "^4.1.0",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@tweakpane/plugin-camerakit": "^0.3.0",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "camera-controls": "^3.1.2",
    "dotenv": "^17.2.3",
    "emoji-regex": "^10.4.0",
    "glob": "^13.0.6",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "msgpack-lite": "^0.1.26",
    "normalize-wheel": "^1.0.1",
    "seedrandom": "^3.0.5",
    "sharp": "^0.34.5",
    "stats-gl": "^4.0.2",
    "stylus": "^0.64.0",
    "three": "^0.183.1",
    "tweakpane": "^4.0.4",
    "uuid": "^13.0.0",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
